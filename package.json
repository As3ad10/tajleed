{
	"name": "tajleed",
	"private": true,
	"version": "0.0.1",
	"description": "Tajleed (تَجْليد) project foundation",
	"type": "module",
	"packageManager": "npm@11.8.0",
	"engines": {
		"node": ">=24.13.1 <25"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:browser": "playwright test"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/fontkit": "^2.0.9",
		"@types/node": "^24",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"buffer": "^6.0.3",
		"bwip-js": "^4.11.4",
		"fontkit": "^2.0.4",
		"idb": "^8.0.4",
		"pdf-lib": "^1.17.1",
		"zod": "^4.6.7"
	}
}
